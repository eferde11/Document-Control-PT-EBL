{
  "rules": {
    ".read": true,
    "documents": {
      "$id": {
        ".write": "auth != null && (auth.token.email === 'docoebl@ebl.app' || (auth.token.email === 'dept@ebl.app' && newData.exists() && (newData.child('m').val() === 11 || newData.child('m').val() === 12) && (!data.exists() || data.child('m').val() === 11 || data.child('m').val() === 12)))",
        ".validate": "newData.hasChildren(['j', 'm'])",
        "j": {
          ".validate": "newData.isString() && newData.val().length <= 500000"
        },
        "m": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "findings": {
      "$id": {
        ".write": "auth != null && (auth.token.email === 'docoebl@ebl.app' || (auth.token.email === 'dept@ebl.app' && data.exists() && newData.exists()))",
        ".validate": "newData.hasChildren(['j'])",
        "j": {
          ".validate": "newData.isString() && newData.val().length <= 500000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}